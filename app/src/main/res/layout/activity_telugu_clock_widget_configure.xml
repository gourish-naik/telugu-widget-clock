<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Live Preview -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Preview"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="8dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="24dp"
            android:background="#2C2C2C"
            android:padding="16dp">

            <ImageView
                android:id="@+id/preview_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="Clock Preview" />
        </FrameLayout>

        <!-- Settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customize Widget"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="12dp" />

        <!-- Font Size -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Base font size"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/font_size_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="56"
            android:layout_marginBottom="12dp" />

        <!-- Font Color with Color Picker -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Font color"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/color_picker_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Pick Color"
                android:layout_marginEnd="8dp" />

            <View
                android:id="@+id/color_preview"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:background="@android:color/white"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <!-- Font Family -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Font family"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/font_family_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <!-- Checkboxes -->
        <CheckBox
            android:id="@+id/font_bold_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bold text" />

        <CheckBox
            android:id="@+id/show_text_shadow_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text shadow"
            android:checked="true" />

        <!-- Date Options -->
        <CheckBox
            android:id="@+id/show_date_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show date below time"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date format"
            android:textSize="14sp"
            android:paddingTop="8dp" />

        <RadioGroup
            android:id="@+id/date_format_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            
            <RadioButton 
                android:id="@+id/date_format_1"
                android:text="Day, Date, Month (ఆది ౧౫ జనవరి)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true" />
            
            <RadioButton 
                android:id="@+id/date_format_2"
                android:text="Date - Month - Year (౧౫ - జనవరి - ౨౦౨౫)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </RadioGroup>

        <!-- Overlay Options -->
        <CheckBox
            android:id="@+id/show_background_overlay_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show background overlay"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Overlay theme (50% transparency)"
            android:textSize="14sp"
            android:paddingTop="8dp" />

        <RadioGroup
            android:id="@+id/overlay_theme_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            
            <RadioButton 
                android:id="@+id/overlay_black"
                android:text="Black"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:checked="true" />
            
            <RadioButton 
                android:id="@+id/overlay_white"
                android:text="White"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
        </RadioGroup>

        <!-- Time Format -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time format"
            android:textSize="14sp"
            android:paddingTop="8dp" />

        <RadioGroup
            android:id="@+id/time_format_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            
            <RadioButton 
                android:id="@+id/format_12_hour_radio_button"
                android:text="12-hour"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:checked="true" />
            
            <RadioButton 
                android:id="@+id/format_24_hour_radio_button"
                android:text="24-hour"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
        </RadioGroup>

        <!-- Save Button -->
        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Widget"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
