<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/font_size_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Font Size (e.g., 48)"
        android:inputType="number" />

    <EditText
        android:id="@+id/font_color_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Font Color (e.g., #FFFFFF)" />

    <CheckBox
        android:id="@+id/font_bold_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bold Font"
        android:layout_marginTop="8dp"/>

    <CheckBox
        android:id="@+id/show_background_overlay_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show Background Overlay"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/background_overlay_color_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Overlay Color (e.g., #80000000 for 50% black)" />

    <CheckBox
        android:id="@+id/show_date_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show Date"
        android:layout_marginTop="8dp"/>

    <CheckBox
        android:id="@+id/show_text_shadow_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show Text Shadow"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Horizontal Gravity"
        android:layout_marginTop="16dp"/>

    <RadioGroup
        android:id="@+id/horizontal_gravity_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/left_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Left" />

        <RadioButton
            android:id="@+id/center_horizontal_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Center"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/right_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Right" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vertical Gravity"
        android:layout_marginTop="16dp"/>

    <RadioGroup
        android:id="@+id/vertical_gravity_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/top_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top" />

        <RadioButton
            android:id="@+id/center_vertical_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Center"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/bottom_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bottom" />
    </RadioGroup>

    <Button
        android:id="@+id/save_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Save" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time Format"
        android:layout_marginTop="16dp"/>

    <RadioGroup
        android:id="@+id/time_format_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/format_12_hour_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12-hour"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/format_24_hour_radio_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24-hour" />
    </RadioGroup>

    <CheckBox
        android:id="@+id/show_am_pm_icon_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show AM/PM Icon"
        android:layout_marginTop="8dp"/>

</LinearLayout>
